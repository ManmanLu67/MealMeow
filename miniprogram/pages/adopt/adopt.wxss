.adopt { display: flex; flex-direction: column; padding-top: 24rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.looks { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 32rpx; }
.look { display: flex; flex-direction: column; align-items: center; box-sizing: border-box; width: calc((100% - 24rpx) / 2); margin-bottom: 24rpx; padding: 16rpx 0 20rpx; border: 2rpx solid var(--border); border-radius: var(--radius-lg); background: var(--surface); }
.look-on { border: 4rpx solid var(--brand-strong); }
.look-art { display: flex; align-items: center; justify-content: center; width: 100%; height: 220rpx; }
.look-img { width: 200rpx; height: 190rpx; }
.cool-img { width: 240rpx; height: 228rpx; }
.warn { margin-top: 40rpx; text-align: center; }
.name-field { margin-top: 32rpx; padding: 24rpx 32rpx; border-radius: var(--radius-lg); background: var(--surface); border: 2rpx solid var(--border); }
.name-label { display: block; }
.name-input { margin-top: 8rpx; height: 56rpx; font-size: 32rpx; line-height: 48rpx; color: var(--ink); }
.name-placeholder { color: var(--ink-disabled); }
.footer { margin-top: auto; padding-top: 32rpx; }

.cool { display: flex; flex-direction: column; align-items: center; margin-top: 48rpx; padding: 40rpx 32rpx; border-radius: var(--radius-xl); background: var(--grass-memorial); }
.cool-title { margin-top: 16rpx; }
.cool-days { margin: 16rpx 0; }
.dialog-body { margin-top: 16rpx; }
