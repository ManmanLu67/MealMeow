<view class="page adopt">
  <block wx:if="{{canAdopt}}">
    <text class="t-title">请选择</text>
    <view class="looks">
      <view
        wx:for="{{looks}}"
        wx:key="id"
        class="look {{species === item.id ? 'look-on' : ''}}"
        data-species="{{item.id}}"
        bindtap="selectLook"
      >
        <view class="look-art">
          <image class="look-img" src="{{item.src}}" mode="aspectFit"></image>
        </view>
        <text class="t-label">{{item.name}}</text>
      </view>
    </view>
    <text class="t-body warn">连续漏餐会饿死，死亡不可恢复。</text>
    <view class="name-field">
      <text class="t-body name-label">给它取个名字（可不填）</text>
      <input class="name-input" value="{{name}}" maxlength="6" placeholder="小饭" placeholder-class="name-placeholder" bindinput="onName" />
    </view>
    <view class="footer">
      <view class="btn btn-primary" bindtap="ask" hover-class="btn-primary-on" hover-stay-time="120"><text class="t-button">确认领养</text></view>
    </view>
  </block>

  <block wx:else>
    <view class="cool">
      <image class="cool-img" src="/assets/pet/cat.webp" mode="aspectFit"></image>
      <text class="t-title cool-title">还在冷却中</text>
      <text class="t-display cool-days">{{cooldownDays}} 天</text>
      <text class="t-caption">冷却结束的那天凌晨 4 点，可以领养新宠物。</text>
    </view>
    <view class="footer">
      <view class="btn btn-primary btn-disabled"><text class="t-button">冷却剩余 {{cooldownDays}} 天</text></view>
    </view>
  </block>

  <block wx:if="{{dialog}}">
    <view class="mask" bindtap="closeDialog"></view>
    <view class="dialog">
      <text class="t-title">确认领养</text>
      <view class="dialog-body"><text class="t-body">连续漏餐会饿死，死亡不可恢复。</text></view>
      <view class="dialog-actions">
        <view class="btn btn-secondary dialog-actions-btn" bindtap="closeDialog" hover-class="btn-secondary-on"><text>取消</text></view>
        <view class="btn btn-primary dialog-actions-btn" bindtap="confirm" hover-class="btn-primary-on"><text class="t-label">确认</text></view>
      </view>
    </view>
  </block>
</view>
