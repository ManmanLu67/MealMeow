.page.gallery { padding-top: 32rpx; padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); background: #F7F8F9; color: #1A1A1A; }
.gallery .t-title { font-weight: 800; color: #1A1A1A; }

/* 日期条：7 格等宽，高 64px，选中为 brand-tint，今天下方一个小圆点。 */
.month-row { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; }
.month-nav { display: flex; flex: 1; align-items: center; min-width: 0; }
.month-arrow { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; }
.month-label { margin-left: 0; }
.month-info { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 64rpx; height: 64rpx; margin-left: 8rpx; }
.month-info-mark { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 40rpx; height: 40rpx; border: 2rpx solid var(--ink-secondary); border-radius: 50%; color: var(--ink-secondary); font-size: 24rpx; line-height: 1; font-weight: 600; font-style: italic; }
.chev-left { transform: rotate(-135deg); }
.month-grid { display: flex; flex-wrap: wrap; margin-top: 8rpx; }
.month-head { width: calc(100% / 7); height: 48rpx; line-height: 48rpx; text-align: center; color: #6F7A74; }
.month-grid .day { width: calc(100% / 7); }
.month-blank { background: transparent; border-color: transparent; }

.strip { display: flex; justify-content: space-between; margin-top: 32rpx; }
.day { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; width: calc((100% - 48rpx) / 7); height: 112rpx; border: 4rpx solid transparent; border-radius: 8rpx; background: transparent; color: #D1D5DB; }
.day-marked { background: #8F9E63; border-color: #1A1A1A; border-width: 2rpx; color: #1A1A1A; }
.day-on { background: #FFC107; border-color: #1A1A1A; border-width: 4rpx; color: #1A1A1A; }
.day-picked { border-color: #1A1A1A; border-style: dashed; border-width: 4rpx; color: #1A1A1A; }
.day-on .day-num, .day-on .day-week, .day-picked .day-num, .day-picked .day-week, .day-marked .day-num, .day-marked .day-week { color: #1A1A1A; }
.day-star { position: absolute; left: 60rpx; top: -14rpx; width: 32rpx; height: 32rpx; }
.day-hover { background: #F7F8F9; }
.day-num { margin-top: 4rpx; font-weight: 800; }
.day-dot { position: absolute; bottom: 10rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: transparent; }
.day-dot-today { background: #1A1A1A; }

/* 三餐格：3 列，间距 8，正方形，radius-md。
 * 餐次名标签固定在左上角，内容（照片、口粮图标和文字）放在下半部分，避免互相压住。 */
.tiles { display: flex; justify-content: space-between; margin-top: 32rpx; }
.tile { position: relative; box-sizing: border-box; width: calc((100% - 32rpx) / 3); height: 0; padding-bottom: calc((100% - 32rpx) / 3); overflow: hidden; border: 4rpx solid #1A1A1A; border-radius: 8rpx; background: #FFFFFF; }
.face-empty { border-style: dashed; background: #F7F8F9; }
.face-window, .face-waiting { border-color: #D1D5DB; }
.face-waiting { background: #F7F8F9; }
.face-waiting .tile-name { background: #F7F8F9; }
.tile-plate { position: absolute; left: 50%; top: 50%; width: 72rpx; height: 72rpx; margin-left: -36rpx; margin-top: -36rpx; }
.tile-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.tile-staple { position: absolute; left: 0; right: 0; bottom: 0; top: 56rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.tile-icon { width: 56rpx; height: 56rpx; margin-bottom: 4rpx; }
.tile-corner { position: absolute; right: 16rpx; bottom: 16rpx; width: 40rpx; height: 40rpx; opacity: 0.8; }
.tile-name { position: absolute; left: 12rpx; top: 12rpx; padding: 0 16rpx; border-radius: var(--radius-pill); background: var(--surface); }
.tile-name-text { color: var(--ink); }

/* 零食：三餐格下方单独一行，缩略图横排。 */
.snack-title { display: block; margin-top: 40rpx; }
.snack-row { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.snack-thumb { position: relative; box-sizing: border-box; width: calc((100% - 32rpx) / 3); height: 0; padding-bottom: calc((100% - 32rpx) / 3); margin-right: 16rpx; margin-bottom: 16rpx; overflow: hidden; border: 4rpx solid #1A1A1A; border-radius: 8rpx; background: #FFFFFF; }
.snack-thumb:nth-child(3n) { margin-right: 0; }
.snack-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.snack-count { position: absolute; right: 12rpx; bottom: 12rpx; padding: 2rpx 16rpx; border-radius: var(--radius-pill); background: var(--surface); }
.snack-count .count-text { color: var(--ink); }

.viewer-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 100; display: flex; flex-direction: column; justify-content: flex-end; background: rgba(34, 41, 38, 0.92); }
.viewer-photo-wrap { display: flex; flex: 1; align-items: center; justify-content: center; width: 100%; min-height: 0; padding: 24rpx 24rpx 0; }
.viewer-img { width: 100%; max-height: 100%; }
.viewer-sheet { flex-shrink: 0; box-sizing: border-box; width: 100%; padding: 24rpx 40rpx calc(32rpx + env(safe-area-inset-bottom)); background: var(--surface); border-radius: var(--radius-xl) var(--radius-xl) 0 0; }
.viewer-note { box-sizing: border-box; width: 100%; min-height: 96rpx; max-height: 240rpx; padding: 16rpx 24rpx; border: 2rpx solid var(--border); border-radius: var(--radius-md); background: var(--surface-sunken); color: var(--ink); }
.viewer-time { display: block; margin-top: 16rpx; }
.viewer-actions { display: flex; justify-content: space-between; margin-top: 32rpx; }
.viewer-btn { width: calc((100% - 16rpx) / 2); height: 96rpx; }
