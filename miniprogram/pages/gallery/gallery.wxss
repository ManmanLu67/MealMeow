.gallery { padding-top: 24rpx; }

/* 日期条：7 格等宽，高 64px，选中为 brand-tint，今天下方一个小圆点。 */
.strip { display: flex; justify-content: space-between; margin-top: 32rpx; }
.day { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; width: calc((100% - 72rpx) / 7); height: 128rpx; border-radius: var(--radius-md); color: var(--ink); }
.day-on { background: var(--brand-tint); }
.day-on .day-num, .day-on .day-week { color: var(--brand-on-tint); }
.day-hover { background: var(--surface-sunken); }
.day-num { margin-top: 4rpx; }
.day-dot { position: absolute; bottom: 12rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: transparent; }
.day-dot-today { background: var(--brand-strong); }

/* 三餐格：3 列，间距 8，正方形，radius-md。
 * 餐次名标签固定在左上角，内容（照片、口粮图标和文字）放在下半部分，避免互相压住。 */
.tiles { display: flex; justify-content: space-between; margin-top: 32rpx; }
.tile { position: relative; box-sizing: border-box; width: calc((100% - 32rpx) / 3); height: 0; padding-bottom: calc((100% - 32rpx) / 3); overflow: hidden; border-radius: var(--radius-md); background: var(--surface-sunken); }
.tile-empty { border: 4rpx dashed var(--border); background: var(--surface-sunken); }
.tile-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.tile-staple { position: absolute; left: 0; right: 0; bottom: 0; top: 56rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.tile-icon { width: 56rpx; height: 56rpx; margin-bottom: 4rpx; }
.tile-corner { position: absolute; right: 16rpx; bottom: 16rpx; width: 40rpx; height: 40rpx; opacity: 0.8; }
.tile-name { position: absolute; left: 12rpx; top: 12rpx; padding: 0 16rpx; border-radius: var(--radius-pill); background: var(--surface); }
.tile-name-text { color: var(--ink); }

/* 零食：三餐格下方单独一行，缩略图横排。 */
.snack-title { display: block; margin-top: 40rpx; }
.snack-row { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.snack-thumb { position: relative; box-sizing: border-box; width: calc((100% - 32rpx) / 3); height: 0; padding-bottom: calc((100% - 32rpx) / 3); margin-right: 16rpx; margin-bottom: 16rpx; overflow: hidden; border-radius: var(--radius-md); background: var(--surface-sunken); }
.snack-thumb:nth-child(3n) { margin-right: 0; }
.snack-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.snack-count { position: absolute; right: 12rpx; bottom: 12rpx; padding: 2rpx 16rpx; border-radius: var(--radius-pill); background: var(--surface); }
.snack-count .count-text { color: var(--ink); }

.empty { margin-top: 48rpx; text-align: center; }

.viewer { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 100; display: flex; align-items: center; justify-content: center; background: rgba(34, 41, 38, 0.92); }
.viewer-img { width: 100%; height: 100%; }
