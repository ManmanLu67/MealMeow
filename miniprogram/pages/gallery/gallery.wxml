<view class="page gallery">
  <text class="t-title">连续打卡 {{streak}} 天</text>

  <view class="month-row">
    <view class="month-nav">
      <view wx:if="{{showPrev}}" class="month-arrow" bindtap="onPrevMonth" hover-class="day-hover" hover-stay-time="120">
        <view class="chev chev-left"></view>
      </view>
      <text class="t-body month-label" bindtap="toggleCalendar">{{monthLabel}}</text>
      <view wx:if="{{showNext}}" class="month-arrow" bindtap="onNextMonth" hover-class="day-hover" hover-stay-time="120">
        <view class="chev"></view>
      </view>
    </view>
    <view class="month-info" bindtap="onPhotoHintTap" hover-class="day-hover" hover-stay-time="120" aria-label="说明">
      <text class="month-info-mark">i</text>
    </view>
  </view>

  <view wx:if="{{calendarOpen && calendarCells.length}}" class="month-grid">
    <view wx:for="{{weekHeads}}" wx:key="*this" class="month-head"><text class="t-caption">{{item}}</text></view>
    <view
      wx:for="{{calendarCells}}"
      wx:key="key"
      class="day month-cell {{item.blank ? 'month-blank' : ''}} {{item.today ? 'day-on' : ''}} {{item.key === selectedKey && !item.today ? 'day-picked' : ''}} {{item.marked && !item.today ? 'day-marked' : ''}}"
      data-key="{{item.key}}"
      bindtap="pickCalendarDay"
    >
      <image wx:if="{{item.star}}" class="day-star" src="/assets/icon/star.png" mode="aspectFit"></image>
      <text wx:if="{{!item.blank}}" class="t-label day-num">{{item.day}}</text>
    </view>
  </view>

  <view wx:if="{{!calendarOpen}}" class="strip">
    <view
      wx:for="{{days}}"
      wx:key="key"
      class="day {{index === todayIndex ? 'day-on' : ''}} {{index === selected && index !== todayIndex ? 'day-picked' : ''}} {{item.marked && index !== todayIndex ? 'day-marked' : ''}}"
      data-index="{{index}}"
      bindtap="selectDay"
      hover-class="day-hover"
      hover-stay-time="120"
    >
      <image wx:if="{{item.star}}" class="day-star" src="/assets/icon/star.png" mode="aspectFit"></image>
      <text class="t-caption day-week">{{item.week}}</text>
      <text class="t-label day-num">{{item.day}}</text>
      <view class="day-dot {{index === todayIndex ? 'day-dot-today' : ''}}"></view>
    </view>
  </view>

  <view wx:if="{{meals.length}}" class="tiles">
    <view
      wx:for="{{meals}}"
      wx:key="meal"
      class="tile face-{{item.face || (item.photo ? 'photo' : (item.exempt ? 'staple' : 'empty'))}}"
      data-index="{{index}}"
      bindtap="openTile"
    >
      <image wx:if="{{item.photo}}" class="tile-img" src="{{item.photo}}" mode="aspectFill"></image>
      <block wx:elif="{{item.exempt}}">
        <view class="tile-staple">
          <image class="tile-icon" src="/assets/icon/cutlery.png" mode="aspectFit"></image>
          <text class="t-caption">口粮</text>
        </view>
      </block>
      <image wx:elif="{{item.face === 'window' || item.face === 'waiting'}}" class="tile-plate" src="/assets/icon/plate.png" mode="aspectFit"></image>
      <image wx:else class="tile-corner" src="/assets/icon/cutlery.png" mode="aspectFit"></image>
      <view class="tile-name"><text class="t-caption tile-name-text">{{item.name}}</text></view>
    </view>
  </view>

  <block wx:if="{{snacks.length}}">
    <text class="t-label snack-title">零食</text>
    <view class="snack-row">
      <view
        wx:for="{{snacks}}"
        wx:key="startedAt"
        class="snack-thumb"
        data-index="{{index}}"
        bindtap="openSnack"
      >
        <image class="snack-img" src="{{item.photo}}" mode="aspectFill"></image>
        <view wx:if="{{item.count > 1}}" class="snack-count"><text class="t-caption count-text">×{{item.count}}</text></view>
      </view>
    </view>
  </block>

  <view wx:if="{{viewerOpen}}" class="viewer-mask" bindtap="closeViewer">
    <view class="viewer-photo-wrap">
      <image class="viewer-img" src="{{viewerPhoto}}" mode="aspectFit" catchtap="stopTap"></image>
    </view>
    <view class="viewer-sheet" catchtap="stopTap">
        <textarea
          class="viewer-note t-body"
          value="{{viewerText}}"
          bindinput="onViewerInput"
          maxlength="200"
          auto-height
          show-confirm-bar="{{false}}"
          placeholder="写一句话"
        ></textarea>
        <text wx:if="{{viewerTimeOne}}" class="t-caption viewer-time">{{viewerTimeOne}}</text>
        <block wx:elif="{{viewerTimeWrote}}">
          <text class="t-caption viewer-time">写下 {{viewerTimeWrote}}</text>
          <text class="t-caption viewer-time">改过 {{viewerTimeEdited}}</text>
        </block>
        <view class="viewer-actions">
          <view class="btn btn-secondary viewer-btn" bindtap="saveViewerPhoto" hover-class="btn-secondary-on" hover-stay-time="120"><text>保存到相册</text></view>
          <view class="btn btn-primary viewer-btn" bindtap="finishViewer" hover-class="btn-primary-on" hover-stay-time="120"><text class="t-button">完成</text></view>
        </view>
    </view>
  </view>
</view>