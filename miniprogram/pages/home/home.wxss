/* 首页按《首页 UI 规格》。令牌只在这一页用，不改其他页。不用 gap。 */
.page.home {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  height: 100vh;
  overflow: hidden;
  padding: 0 32rpx calc(160rpx + env(safe-area-inset-bottom));
  background: #F7F8F9;
  color: #1A1A1A;
  font-family: "PingFang SC", "Noto Sans SC", "Microsoft YaHei", sans-serif;
}

.home-body { display: flex; flex: 1; flex-direction: column; min-height: 0; }
.top { display: flex; flex-shrink: 0; align-items: stretch; padding-top: 16rpx; }
.stat { box-sizing: border-box; width: 280rpx; padding: 8rpx 20rpx; background: #FFFFFF; border: 4rpx solid #1A1A1A; border-radius: 8rpx; }
.stat-row { display: flex; align-items: center; justify-content: space-between; height: 76rpx; border-bottom: 2rpx solid #1A1A1A; }
.stat-row:last-child { border-bottom: none; }
.stat-k { font-size: 28rpx; font-weight: 400; letter-spacing: 0.08em; }
.stat-v { font-size: 32rpx; font-weight: 800; }

.meals { display: flex; flex: 1; flex-direction: column; justify-content: space-between; min-width: 0; margin-left: 20rpx; overflow: visible; }
.meal { position: relative; display: flex; flex-direction: row; align-items: center; justify-content: space-between; box-sizing: border-box; width: 100%; height: 72rpx; padding: 0 24rpx; background: #FFFFFF; border: 4rpx solid #1A1A1A; border-radius: 8rpx; overflow: visible; }
.meal-time { font-size: 24rpx; font-weight: 600; line-height: 32rpx; letter-spacing: 0.02em; color: #6B6B6B; }
.meal-name { font-size: 30rpx; font-weight: 800; line-height: 36rpx; color: #1A1A1A; }
.meal-done { background: #8F9E63; }
.meal-done .meal-time { color: #1A1A1A; }
.meal-now { background: #FFC107; box-shadow: 6rpx 6rpx 0 #1A1A1A; }
.meal-now .meal-time { color: #1A1A1A; }
.meal-miss { background: #F7F8F9; }
.meal-miss .meal-time { color: #6B6B6B; }
.meal-miss .meal-name { color: #6B6B6B; }
.meal-wait { background: #FFFFFF; border-color: #6B6B6B; }
.meal-wait .meal-time { color: #6B6B6B; }
.meal-wait .meal-name { color: #6B6B6B; }
.badge { position: absolute; top: -14rpx; right: -14rpx; display: flex; align-items: center; justify-content: center; width: 36rpx; height: 36rpx; background: #FFFFFF; border: 4rpx solid #1A1A1A; border-radius: 50%; }
.tick { width: 14rpx; height: 8rpx; margin-top: -4rpx; border-bottom: 4rpx solid #1A1A1A; border-left: 4rpx solid #1A1A1A; transform: rotate(-45deg); }

.center { position: relative; flex: 1; width: 100%; min-height: 0; overflow: hidden; }
.stage { position: absolute; left: 0; top: 0; width: 100%; height: 996rpx; transform-origin: top center; }
.pet-img { position: absolute; z-index: 1; left: 134rpx; top: 88rpx; width: 482rpx; height: 458rpx; }
.pet-img-cat { left: 76rpx; top: 56rpx; width: 560rpx; height: 490rpx; }

.bowl { position: absolute; left: 174rpx; top: 434rpx; z-index: 2; width: 168rpx; height: 112rpx; }
.bowl-plate, .bowl-kibble { position: absolute; left: 0; top: 0; width: 168rpx; height: 112rpx; }

.bag { position: absolute; left: 40rpx; top: 444rpx; z-index: 3; width: 109rpx; height: 132rpx; }
.polaroid { position: absolute; z-index: 4; box-sizing: border-box; width: 148rpx; height: 176rpx; padding: 12rpx 12rpx 40rpx; background: #FFFFFF; border: 4rpx solid #1A1A1A; border-radius: 4rpx; box-shadow: 6rpx 6rpx 0 #1A1A1A; transform: rotate(-5deg); overflow: visible; }
.polaroid-photo { display: block; width: 116rpx; height: 116rpx; background: #F7F8F9; }
.polaroid-pin { position: absolute; left: 56rpx; top: -20rpx; z-index: 2; width: 36rpx; height: 44rpx; transform: rotate(5deg); }
.polaroid-breakfast { left: 27rpx; top: 640rpx; }
.polaroid-lunch { left: 271rpx; top: 604rpx; }
.polaroid-dinner { left: 513rpx; top: 638rpx; }

.adopt { position: absolute; left: 50%; top: 88rpx; z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 482rpx; height: 458rpx; margin-left: -241rpx; }
.pasture {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 6;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.pasture .adopt, .pasture .cam { pointer-events: auto; }
.pasture .adopt { position: relative; left: auto; top: auto; width: auto; height: auto; margin-left: 0; }
.pasture .cam { position: relative; left: auto; top: auto; margin-top: 48rpx; margin-left: 0; }
.person { display: block; width: 204rpx; height: 333rpx; }
.adopt-label { display: block; margin-top: 27rpx; padding: 14rpx 41rpx 14rpx 48rpx; background: #FFFFFF; border: 7rpx solid #1A1A1A; border-radius: 14rpx; font-size: 48rpx; font-weight: 800; line-height: 48rpx; letter-spacing: 0.14em; text-align: center; color: #1A1A1A; }

.memo-mark { position: absolute; right: 0; top: 16rpx; z-index: 5; width: 174rpx; height: 158rpx; }
.album-img { width: 174rpx; height: 158rpx; }

.cam { position: absolute; left: 50%; top: 828rpx; z-index: 6; width: 168rpx; height: 168rpx; margin-left: -84rpx; }
.cam-press { opacity: 0.72; }
.cam-img { width: 168rpx; height: 168rpx; }

.pick-row { margin-top: 24rpx; }
.kv { display: flex; align-items: center; justify-content: space-between; min-height: 96rpx; border-bottom: 2rpx solid #DFE4E1; }
.sheet-note { display: block; margin-top: 24rpx; }
