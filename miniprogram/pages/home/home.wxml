<view class="page home" style="padding-top: {{padTop}}px">
  <view class="home-body">
  <view class="top">
    <view class="stat">
      <view class="stat-row"><text class="stat-k">饥饿</text><text class="stat-v">{{hungerText}}</text></view>
      <view class="stat-row"><text class="stat-k">健康</text><text class="stat-v">{{healthText}}</text></view>
      <view class="stat-row"><text class="stat-k">等级</text><text class="stat-v">{{levelText}}</text></view>
    </view>
    <view class="meals">
    <view
      wx:for="{{chips}}"
      wx:key="meal"
      class="meal meal-{{item.tone}}"
      data-meal="{{item.meal}}"
      bindtap="onChip"
    >
      <view wx:if="{{item.tone === 'done'}}" class="badge"><view class="tick"></view></view>
      <text class="meal-time">{{item.time}}</text>
      <text class="meal-name">{{item.name}}</text>
    </view>
    </view>
  </view>

  <view class="center">
  <view wx:if="{{petView === 'pasture'}}" class="stage" style="transform: scale({{stageScale}});">
    <view class="adopt">
      <image class="person" src="/assets/icon/person.webp" mode="aspectFit" bindtap="onPetTap"></image>
      <text class="adopt-label" bindtap="goAdopt">领养</text>
    </view>
    <view wx:for="{{photos}}" wx:key="meal" class="polaroid polaroid-{{item.meal}}">
      <image class="polaroid-pin" src="/assets/icon/pin.webp" mode="aspectFit"></image>
      <image class="polaroid-photo" src="{{item.src}}" mode="aspectFill"></image>
    </view>
  </view>

  <view wx:if="{{petView !== 'pasture'}}" class="stage" style="transform: scale({{stageScale}});">
    <view wx:if="{{showMemorial}}" class="memo-mark" catchtap="openMemorial">
      <image class="album-img" src="/assets/icon/album.webp" mode="aspectFit"></image>
    </view>

    <block wx:if="{{petView === 'living'}}">
      <image
        class="pet-img {{species === 'cat' ? 'pet-img-cat' : ''}}"
        src="{{petSrc}}"
        mode="aspectFit"
        bindtap="onPetTap"
        bindlongpress="openPet"
      ></image>
      <view class="bowl" aria-label="{{bowlFill > 0 ? '食盘（有丸子）' : '食盘（空）'}}">
        <image class="bowl-plate" src="/assets/icon/bowl-plate.webp" mode="aspectFit"></image>
        <image wx:if="{{bowlFill > 0}}" class="bowl-kibble" style="opacity: {{bowlOpacity}};" src="/assets/icon/bowl-kibble.webp" mode="aspectFit"></image>
      </view>
    </block>

    <view wx:else class="adopt">
      <image class="person" src="/assets/icon/person.webp" mode="aspectFit" bindtap="onPetTap"></image>
      <text class="adopt-label" bindtap="goAdopt">领养</text>
    </view>

    <image wx:if="{{showBag}}" class="bag" src="/assets/icon/bag.webp" mode="aspectFit"></image>

    <view wx:for="{{photos}}" wx:key="meal" class="polaroid polaroid-{{item.meal}}">
      <image class="polaroid-pin" src="/assets/icon/pin.webp" mode="aspectFit"></image>
      <image class="polaroid-photo" src="{{item.src}}" mode="aspectFill"></image>
    </view>
  </view>
  <view class="stage cam-layer" style="transform: scale({{stageScale}});">
    <view class="cam {{petView === 'living' && species === 'samoyed' ? 'cam-dog' : ''}} {{petView === 'living' ? '' : 'cam-with-person'}}" hover-class="cam-press" hover-stay-time="80" bindtap="onCamera" aria-label="拍照记录">
      <image class="cam-img" src="{{cameraSrc}}" mode="aspectFit"></image>
    </view>
  </view>
  </view>
  </view>

  <block wx:if="{{sheet === 'pick'}}">
    <view class="mask" bindtap="closeSheet"></view>
    <view class="sheet sheet-pick">
      <view class="sheet-grip"></view>
      <text class="t-title">选择打卡</text>
      <view
        wx:for="{{pickMeals}}"
        wx:key="meal"
        class="btn btn-secondary pick-row"
        data-meal="{{item.meal}}"
        bindtap="pickMeal"
        hover-class="btn-secondary-on"
      >
        <text>{{item.name}}</text>
      </view>
      <view wx:if="{{showSnack}}" class="btn btn-secondary pick-row" bindtap="onPickSnack" hover-class="btn-secondary-on">
        <text>零食</text>
      </view>
    </view>
  </block>

  <block wx:if="{{sheet === 'pet'}}">
    <view class="mask" bindtap="closeSheet"></view>
    <view class="sheet">
      <view class="sheet-grip"></view>
      <text class="t-title">{{petName}} · 陪伴与记录</text>
      <view class="kv"><text class="t-body">陪伴</text><text class="t-title">{{companyDays}} 天</text></view>
      <view class="kv"><text class="t-body">共吃</text><text class="t-title">{{mealsEaten}} 餐</text></view>
      <text class="t-caption sheet-note">{{bandNote}}</text>
    </view>
  </block>

</view>
