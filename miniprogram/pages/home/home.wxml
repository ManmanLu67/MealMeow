<view class="page home" style="padding-top: {{padTop}}px">
  <view class="home-body">
  <view class="top">
    <view class="stat" bindtap="openStat">
      <view class="stat-row stat-row-satiety">
        <text class="stat-k">饱腹</text>
        <view class="satiety-track">
          <view class="satiety-fill" style="width: {{satietyBarWidth}}%;"></view>
          <text class="satiety-text {{satietyBarWidth >= 48 ? 'satiety-text-light' : 'satiety-text-dark'}}">{{satietyText}}</text>
        </view>
      </view>
      <view class="stat-row"><text class="stat-k">健康</text><text class="stat-v">{{healthText}}</text></view>
      <view class="stat-row"><text class="stat-k">等级</text><text class="stat-v">{{levelText}}</text></view>
    </view>
    <view class="meals">
    <view
      wx:for="{{chips}}"
      wx:key="meal"
      class="meal meal-{{item.tone}}"
      bindtap="onChip"
    >
      <view wx:if="{{item.tone === 'done'}}" class="badge"><view class="tick"></view></view>
      <text class="meal-time">{{item.time}}</text>
      <text class="meal-name">{{item.name}}</text>
    </view>
    </view>
  </view>

  <view class="center">
  <view wx:if="{{petView === 'pasture'}}" class="stage" style="transform: scale({{stageScale}});">
    <view class="adopt">
      <image class="person" src="/assets/icon/person.png" mode="aspectFit" bindtouchstart="onPetTouchStart" bindtouchend="onPetTouchEnd" bindtap="onPetTap"></image>
      <text class="adopt-label" bindtap="goAdopt">领养</text>
    </view>
    <view wx:for="{{photos}}" wx:key="meal" class="polaroid polaroid-{{item.meal}}">
      <image class="polaroid-pin" src="/assets/icon/pin.png" mode="aspectFit"></image>
      <image class="polaroid-photo" src="{{item.src}}" mode="aspectFill"></image>
    </view>
  </view>

  <view wx:if="{{petView !== 'pasture'}}" class="stage" style="transform: scale({{stageScale}});">
    <view wx:if="{{showMemorial}}" class="memo-mark" catchtap="openMemorial">
      <image class="album-img" src="/assets/icon/album.png" mode="aspectFit"></image>
    </view>

    <block wx:if="{{petView === 'living'}}">
      <image
        class="pet-img {{species === 'cat' ? 'pet-img-cat' : ''}}"
        src="{{petSrc}}"
        mode="aspectFit"
        bindtap="onPetTap"
        bindlongpress="openPet"
        bindtouchstart="onPetTouchStart"
        bindtouchend="onPetTouchEnd"
      ></image>
      <view class="bowl" aria-label="{{bowlFill > 0 ? '食盘（有丸子）' : '食盘（空）'}}">
        <image class="bowl-plate" src="/assets/icon/bowl-plate.png" mode="aspectFit"></image>
        <image wx:if="{{bowlFill > 0}}" class="bowl-kibble" style="opacity: {{bowlOpacity}};" src="/assets/icon/bowl-kibble.png" mode="aspectFit"></image>
      </view>
    </block>

    <view wx:else class="adopt">
      <image class="person" src="/assets/icon/person.png" mode="aspectFit" bindtouchstart="onPetTouchStart" bindtouchend="onPetTouchEnd" bindtap="onPetTap"></image>
      <text class="adopt-label" bindtap="goAdopt">领养</text>
    </view>

    <view wx:if="{{petView === 'living'}}" class="bag" bindtap="askStaple">
      <image class="bag-img" src="/assets/icon/bag.png" mode="aspectFit"></image>
      <text class="bag-count">{{stapleLeft}}</text>
    </view>

    <view wx:for="{{photos}}" wx:key="meal" class="polaroid polaroid-{{item.meal}}">
      <image class="polaroid-pin" src="/assets/icon/pin.png" mode="aspectFit"></image>
      <image class="polaroid-photo" src="{{item.src}}" mode="aspectFill"></image>
    </view>
  </view>
  <view class="stage cam-layer" style="transform: scale({{stageScale}});">
    <view class="cam {{petView === 'living' && species === 'samoyed' ? 'cam-dog' : ''}}" hover-class="cam-press" hover-stay-time="80" bindtap="onCamera" aria-label="拍照记录">
      <image class="cam-img" src="{{cameraSrc}}" mode="aspectFit"></image>
    </view>
  </view>
  </view>
  </view>

  <block wx:if="{{sheet === 'pick'}}">
    <view class="mask" bindtap="closeSheet"></view>
    <view class="sheet sheet-pick">
      <view class="sheet-grip"></view>
      <text class="t-title">选择打卡</text>
      <view
        wx:for="{{pickMeals}}"
        wx:key="meal"
        class="btn btn-secondary pick-row"
        data-meal="{{item.meal}}"
        bindtap="pickMeal"
        hover-class="btn-secondary-on"
      >
        <text>{{item.name}}</text>
      </view>
      <view wx:if="{{showSnack}}" class="btn btn-secondary pick-row" bindtap="onPickSnack" hover-class="btn-secondary-on">
        <text>零食</text>
      </view>
    </view>
  </block>

  <block wx:if="{{sheet === 'pet'}}">
    <view class="mask" bindtap="closeSheet"></view>
    <view class="sheet">
      <view class="sheet-grip"></view>
      <text class="t-title">{{petName}} · 陪伴与记录</text>
      <view class="kv"><text class="t-body">陪伴</text><text class="t-title">{{companyDays}} 天</text></view>
      <view class="kv"><text class="t-body">共吃</text><text class="t-title">{{mealsEaten}} 餐</text></view>
      <text class="t-caption sheet-note">{{bandNote}}</text>
    </view>
  </block>

  <block wx:if="{{sheet === 'stat'}}">
    <view class="mask" bindtap="closeSheet"></view>
    <view class="stat-float">
      <scroll-view scroll-y class="stat-scroll">
        <text class="stat-h">今日状态</text>
        <text wx:for="{{statChanges}}" wx:key="*this" class="stat-line">{{item}}</text>
        <text class="stat-h">计算方法</text>
        <text class="stat-kicker">饱腹</text>
        <text class="stat-line">正餐打卡后为 100%，在下餐前掉到 0%。口粮在当前饱腹上加 90。每天前三次零食各加 5%，第四次起不加。可以超过 100%，到 200% 宠物死亡。食盘不随口粮变化。</text>
        <text class="stat-kicker">健康</text>
        <text class="stat-line">与饥饿值无关。初始/为漏餐为 0 档（健康 100），每漏一餐档位加 1（健康约减 11 分），漏满 9 档宠物死亡。进食分段恢复：漏 1~2 餐吃完回 0 档（100），漏 3~5 餐回 2 档（78），漏 6~8 餐回 5 档（44）。</text>
        <text class="stat-kicker">宠物等级</text>
        <text class="stat-line">等级随时间增长。漏餐会扣除宠物等级，健康值越低扣得更多。最低降为 0 级。</text>
      </scroll-view>
    </view>
  </block>

  <guide-spot
    wx:if="{{guide && hole}}"
    hole="{{hole}}"
    bubble="{{bubble}}"
    icon="{{guide.icon}}"
    lead="{{guide.lead}}"
    rest="{{guide.rest}}"
    next="{{guide.next}}"
    bindnext="nextGuide"
  ></guide-spot>

  <nickname-dialog show="{{nicknameOpen}}" value="{{nicknameDraft}}" bindconfirm="onNicknameConfirm" bindcancel="onNicknameCancel"></nickname-dialog>

  <block wx:if="{{stapleDialog}}">
    <view class="mask" bindtap="closeStaple"></view>
    <view class="dialog">
      <block wx:if="{{stapleDialog === 'ask'}}">
        <text class="t-title">使用应急口粮？</text>
        <view class="dialog-body"><text class="t-body t-secondary">每月 2 个，每月不结余。</text></view>
        <view class="dialog-actions">
          <view class="btn btn-secondary dialog-actions-btn" bindtap="closeStaple" hover-class="btn-secondary-on"><text>取消</text></view>
          <view class="btn btn-primary dialog-actions-btn" bindtap="confirmStaple" hover-class="btn-primary-on"><text class="t-label">使用</text></view>
        </view>
      </block>
      <block wx:else>
        <text class="t-title">{{stapleMessage}}</text>
        <view class="dialog-actions">
          <view class="btn btn-primary staple-ok" bindtap="closeStaple" hover-class="btn-primary-on"><text class="t-label">知道了</text></view>
        </view>
      </block>
    </view>
  </block>

  <block wx:if="{{remindMeal}}">
    <view class="mask"></view>
    <view class="dialog">
      <text class="t-title">{{petName}}饿了，请及时打卡投喂哦！</text>
      <view class="dialog-actions">
        <view class="btn btn-secondary dialog-actions-btn" bindtap="dismissRemind" hover-class="btn-secondary-on"><text>稍后</text></view>
        <view class="btn btn-primary dialog-actions-btn" bindtap="goRemindCheckin" hover-class="btn-primary-on"><text class="t-label">去打卡</text></view>
      </view>
    </view>
  </block>

</view>
