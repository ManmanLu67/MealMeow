<view class="page me">
  <view class="profile">
    <view class="avatar"><text class="t-title avatar-text">{{initial}}</text></view>
    <view class="profile-text">
      <text class="t-title">{{nickname}}</text>
      <text class="t-caption">账号 ID：{{accountId}}（仅自己可见）</text>
    </view>
  </view>

  <view class="card">
    <navigator class="list-row" url="/pages/settings/meals/meals" hover-class="list-row-on" hover-stay-time="120">
      <text class="t-body">饭点设置</text><view class="row-right"><view class="chev"></view></view>
    </navigator>
    <navigator class="list-row" url="/pages/settings/reminder/reminder" hover-class="list-row-on" hover-stay-time="120">
      <text class="t-body">提醒设置</text><view class="row-right"><view class="chev"></view></view>
    </navigator>
    <navigator class="list-row" url="/pages/settings/feedback/feedback" hover-class="list-row-on" hover-stay-time="120">
      <text class="t-body">声音与震动</text><view class="row-right"><view class="chev"></view></view>
    </navigator>
    <navigator class="list-row list-row-last" url="/pages/settings/about/about" hover-class="list-row-on" hover-stay-time="120">
      <text class="t-body">隐私与关于</text><view class="row-right"><view class="chev"></view></view>
    </navigator>
  </view>
</view>
