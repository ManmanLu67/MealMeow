<view class="page me">
  <view class="profile">
    <view class="avatar"><text class="t-title avatar-text">{{initial}}</text></view>
    <view class="profile-text">
      <text class="t-title">{{nickname}}</text>
      <text class="t-caption">账号 ID：{{accountId}}（仅自己可见）</text>
    </view>
  </view>

  <view class="settings">
    <navigator class="setting-card" url="/pages/settings/meals/meals" hover-class="setting-card-on" hover-stay-time="120">
      <image class="setting-icon" src="/assets/icon/setting-meals.webp" mode="aspectFit"></image>
      <text class="t-body setting-name">饭点设置</text>
      <view class="chev"></view>
    </navigator>
    <navigator class="setting-card" url="/pages/settings/reminder/reminder" hover-class="setting-card-on" hover-stay-time="120">
      <image class="setting-icon" src="/assets/icon/setting-reminder.webp" mode="aspectFit"></image>
      <text class="t-body setting-name">提醒设置</text>
      <view class="chev"></view>
    </navigator>
    <navigator class="setting-card" url="/pages/settings/sound/sound" hover-class="setting-card-on" hover-stay-time="120">
      <image class="setting-icon" src="/assets/icon/setting-sound.webp" mode="aspectFit"></image>
      <text class="t-body setting-name">声音与震动</text>
      <view class="chev"></view>
    </navigator>
    <navigator class="setting-card" url="/pages/settings/about/about" hover-class="setting-card-on" hover-stay-time="120">
      <image class="setting-icon" src="/assets/icon/setting-privacy.webp" mode="aspectFit"></image>
      <text class="t-body setting-name">隐私与关于</text>
      <view class="chev"></view>
    </navigator>
  </view>
</view>
