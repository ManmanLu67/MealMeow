.page.me { padding-top: 32rpx; padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); background: #F7F8F9; color: #1A1A1A; }
.profile { display: flex; align-items: center; margin-bottom: 48rpx; }
.profile-on { opacity: 0.72; }
.avatar { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; border: 4rpx solid #1A1A1A; border-radius: 50%; background: #FFC107; }
.avatar-text { color: #1A1A1A; font-weight: 800; }
.profile-text { display: flex; flex-direction: column; margin-left: 24rpx; }
.me .t-title { font-weight: 800; color: #1A1A1A; }
.setting-card { display: flex; align-items: center; box-sizing: border-box; height: 112rpx; margin-bottom: 32rpx; padding: 0 32rpx 0 32rpx; background: #FFFFFF; border: 4rpx solid #1A1A1A; border-radius: 8rpx; }
.setting-card-on { background: #F7F8F9; }
.setting-icon { width: 48rpx; height: 48rpx; margin-right: 16rpx; }
.setting-name { flex: 1; }
.close { display: flex; align-items: center; justify-content: center; height: 96rpx; margin-top: 16rpx; border: 4rpx solid #1A1A1A; border-radius: 8rpx; background: #FFFFFF; }
.close-text { font-size: 30rpx; font-weight: 800; color: #B84E0C; }

