.checkin { display: flex; flex-direction: column; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }

.bar { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; }
.bar-close { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; border-radius: 50%; }
.bar-close-on { background: var(--surface-sunken); }
.bar-title { color: var(--ink); }
/* 关闭图标：两条交叉线，不依赖图片。 */
.x { position: relative; width: 36rpx; height: 36rpx; }
.x::before, .x::after { content: ""; position: absolute; left: 50%; top: 0; width: 4rpx; height: 100%; margin-left: -2rpx; border-radius: 2rpx; background: var(--ink); }
.x::before { transform: rotate(45deg); }
.x::after { transform: rotate(-45deg); }

/* 预览区：宽 = 屏宽 − 40，比例 4:5。 */
.preview { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; height: 0; padding-bottom: 125%; margin-top: 16rpx; overflow: hidden; border-radius: var(--radius-lg); background: var(--surface-sunken); }
.preview > .preview-icon, .preview > text { position: relative; }
.preview-icon { width: 96rpx; height: 96rpx; margin-bottom: 16rpx; }
.preview-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.preview-count { position: absolute; right: 24rpx; bottom: 24rpx; padding: 4rpx 24rpx; border-radius: var(--radius-pill); background: var(--surface); }
.count-text { color: var(--ink); }

.actions { display: flex; justify-content: space-between; margin-top: 32rpx; }
.action { width: calc((100% - 16rpx) / 2); }

.footer { margin-top: auto; padding-top: 32rpx; }
.staple-note { margin-top: 32rpx; text-align: center; }
.dialog-body { margin-top: 16rpx; }
