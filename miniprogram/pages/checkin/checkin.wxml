<view class="page">
  <view class="bar">
    <text bindtap="close">关闭</text>
    <text>{{mealName}} · {{checked ? '已打卡' : '窗口至 ' + windowEnd}}</text>
  </view>
  <view class="preview">照片</view>
  <block wx:if="{{checked}}">
    <view class="row">
      <text>替换照片</text>
      <text>删除打卡</text>
    </view>
  </block>
  <block wx:else>
    <view class="row">
      <text>拍照</text>
      <text>相册</text>
    </view>
    <view class="primary">完成打卡</view>
    <view class="link">吃不了？使用应急口粮</view>
  </block>
</view>
