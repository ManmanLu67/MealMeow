@import "styles/tokens.wxss";

/* 共用样式。页面专属样式写在各自的 wxss 里。
 * 不用兄弟选择器和 gap，保证旧版本基础库也能渲染。 */

.page { min-height: 100vh; box-sizing: border-box; padding: 24rpx 40rpx; background: var(--canvas); }
.page-footer-space { padding-bottom: calc(224rpx + env(safe-area-inset-bottom)); }

/* 按钮。每页最多一个主按钮。 */
.btn { display: flex; align-items: center; justify-content: center; box-sizing: border-box; border-radius: var(--radius-pill); transition: transform 120ms ease-out, background-color 120ms ease-out; }
.btn-primary { height: 104rpx; background: var(--brand-strong); color: #FFFFFF; font-size: 34rpx; line-height: 48rpx; font-weight: 600; }
.btn-primary-on { background: #9C420A; transform: scale(0.97); }
.btn-secondary { height: 96rpx; background: var(--surface); border: 2rpx solid var(--border); color: var(--ink); font-size: 28rpx; line-height: 40rpx; font-weight: 500; }
.btn-secondary-on { background: var(--surface-sunken); transform: scale(0.97); }
.btn-danger { color: var(--danger); }
.btn-disabled { background: var(--surface-sunken); border: 2rpx solid var(--surface-sunken); color: var(--ink-disabled); }
.link { display: flex; align-items: center; justify-content: center; min-height: 88rpx; color: var(--brand-strong); font-size: 28rpx; line-height: 40rpx; font-weight: 500; }

/* 卡片和列表行。卡片不用阴影，用白底加 1px 描边。 */
.card { background: var(--surface); border: 2rpx solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
.list-row { display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; min-height: 112rpx; padding: 0 32rpx; border-bottom: 2rpx solid var(--border); background: var(--surface); }
.list-row-last { border-bottom: none; }
.list-row-on { background: var(--surface-sunken); }
.row-right { display: flex; align-items: center; color: var(--ink-secondary); }
.row-right-text { margin-right: 16rpx; }
.chev { width: 14rpx; height: 14rpx; border-top: 4rpx solid var(--ink-disabled); border-right: 4rpx solid var(--ink-disabled); transform: rotate(45deg); }

/* 底部弹层和弹窗。弹窗只有两种：删除打卡确认、领养前生死确认。 */
.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 100; background: rgba(34, 41, 38, 0.4); }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 101; box-sizing: border-box; max-height: 60vh; overflow: hidden; padding: 16rpx 40rpx calc(40rpx + env(safe-area-inset-bottom)); background: var(--surface); border-radius: var(--radius-xl) var(--radius-xl) 0 0; box-shadow: 0 -16rpx 48rpx rgba(34, 41, 38, 0.1); animation: sheet-in 240ms cubic-bezier(0.2, 0.8, 0.2, 1); }
.sheet-grip { width: 72rpx; height: 8rpx; margin: 0 auto 32rpx; border-radius: 4rpx; background: var(--border); }
.dialog { position: fixed; left: 64rpx; right: 64rpx; top: 50%; z-index: 101; box-sizing: border-box; padding: 48rpx 40rpx 32rpx; background: var(--surface); border-radius: var(--radius-lg); transform: translateY(-50%); }
.dialog-actions { display: flex; justify-content: space-between; margin-top: 40rpx; }
.dialog-actions-btn { width: calc((100% - 16rpx) / 2); }

/* 宠物状态标签：展示字体加状态底色。四档对应 DESIGN.md 1.4。 */
.status-tag { display: inline-block; padding: 8rpx 32rpx; border-radius: var(--radius-pill); }
.tag-full { background: var(--ok-bg); color: var(--ok-fg); }
.tag-peckish { background: var(--warn-bg); color: var(--warn-fg); }
.tag-hungry { background: var(--hungry-bg); color: var(--hungry-fg); }
.tag-critical { background: var(--crit-bg); color: var(--crit-fg); }

/* 宠物占位图。正式形象由 AI 出图后替换，换图时只改这一段和页面里的 pet-art。 */
.pet-art { position: relative; width: 400rpx; height: 340rpx; }
.pet-shadow { position: absolute; left: 50%; bottom: 0; width: 300rpx; height: 44rpx; margin-left: -150rpx; border-radius: 50%; background: var(--grass-deep); }
.pet-body { position: absolute; left: 50%; bottom: 24rpx; width: 280rpx; height: 260rpx; margin-left: -140rpx; border-radius: 140rpx 140rpx 120rpx 120rpx; background: #B8693C; }
.pet-eye { position: absolute; top: 112rpx; width: 28rpx; height: 36rpx; border-radius: 50%; background: var(--ink); }
.pet-eye-l { left: 78rpx; }
.pet-eye-r { right: 78rpx; }
.pet-cheek { position: absolute; top: 160rpx; width: 40rpx; height: 24rpx; border-radius: 50%; background: #E3A27E; }
.pet-cheek-l { left: 40rpx; }
.pet-cheek-r { right: 40rpx; }
.pet-critical .pet-body { background: #A8582F; }
.pet-critical .pet-eye { height: 14rpx; top: 124rpx; border-radius: 7rpx; background: #FFFFFF; }
.pet-memorial .pet-body { background: #6F7A74; }
.pet-memorial .pet-eye { height: 8rpx; top: 130rpx; border-radius: 4rpx; background: #FFFFFF; }

@keyframes sheet-in { from { transform: translateY(100%); } to { transform: translateY(0); } }
