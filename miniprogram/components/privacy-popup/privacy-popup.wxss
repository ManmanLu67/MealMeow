.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 200; background: rgba(34, 41, 38, 0.4); }
.dialog { position: fixed; left: 64rpx; right: 64rpx; top: 50%; z-index: 201; box-sizing: border-box; padding: 48rpx 40rpx 32rpx; background: #FFFFFF; border-radius: 32rpx; transform: translateY(-50%); }
.dialog-body { margin-top: 16rpx; }
.dialog-actions { display: flex; justify-content: space-between; margin-top: 40rpx; }
.contract { display: block; margin-top: 16rpx; color: #B84E0C; font-size: 28rpx; line-height: 40rpx; }
.privacy-btn { width: calc((100% - 16rpx) / 2); height: 96rpx; margin: 0; padding: 0; font-size: 28rpx; line-height: 96rpx; font-weight: 500; }
.privacy-btn::after { border: none; }
